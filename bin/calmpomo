#!/usr/bin/env bash
set -uo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
CONF_DIR="${CALMPOMO_CONFIG_DIR:-$HOME/.config/calmpomo}"
STATE_DIR="${CALMPOMO_STATE_DIR:-$HOME/Library/Application Support/calmpomo}"
export TOMAT_CONFIG="$CONF_DIR/tomat.toml"
export TOMAT_RUNTIME_DIR="$STATE_DIR/run"
LOG="$STATE_DIR/sessions.log"

usage() {
  cat <<'EOF'
calmpomo: calm pomodoro on top of tomat

  calmpomo toggle         start, pause or resume (one key for everything)
  calmpomo start [MIN]    start focus, or begin the next focus after a break;
                          MIN sets the focus length until the next reset
  calmpomo pause          pause
  calmpomo skip           jump to the next phase
  calmpomo reset          stop and go back to idle
  calmpomo status         one-line status
  calmpomo mute|unmute    silence or restore sounds
  calmpomo log [N]        last N session log lines (default 20)
  calmpomo watch          JSON stream for the menu bar plugin
EOF
}

state() {
  local s
  s=$(tomat status -o waybar 2>/dev/null) || { echo down; return; }
  case $s in *'"class":"'*) s=${s#*\"class\":\"}; s=${s%%\"*} ;; *) s="" ;; esac
  case $s in
    ''|disconnected) echo down ;;
    work-paused) if [ -e "$STATE_DIR/awaiting" ]; then echo waiting; else echo work-paused; fi ;;
    *) echo "$s" ;;
  esac
}

remaining() {
  local t
  t=$(tomat status -o waybar 2>/dev/null)
  t=${t#*\"text\":\"}
  t=${t%%\"*}
  echo "${t//[!0-9:]/}"
}

fail() { echo "$1"; exit 1; }
down() { fail "calmpomo isn't running · run install.sh"; }
run() { tomat "$@" >/dev/null 2>&1; }

minutes() {
  local m=${1// /}
  m=${m%m}
  [[ $m =~ ^[0-9]+([.][0-9]+)?$ ]] && [[ ! $m =~ ^0+([.]0*)?$ ]] || fail "Minutes must be a positive number"
  echo "$m"
}

start() {
  local st m=""
  st=$(state)
  [ "$st" = down ] && down
  if [ -n "${1:-}" ]; then
    m=$(minutes "$1") || fail "$m"
    # a fresh start resets tomat's long-break counter, so only do it when asked
    run start --work "$m" || fail "Couldn't start focus"
    rm -f "$STATE_DIR/awaiting"
    echo "Focus started · ${m} min"
    return
  fi
  case $st in
    idle) run start || fail "Couldn't start focus"; echo "Focus started" ;;
    waiting) run resume || fail "Couldn't start focus"; echo "Focus started" ;;
    work-paused|break-paused|long-break-paused) run resume || fail "Couldn't resume"; echo "Resumed" ;;
    *) echo "Already running" ;;
  esac
}

pause() {
  case $(state) in
    work|break|long-break) run pause || fail "Couldn't pause"; echo "Paused" ;;
    down) down ;;
    *) echo "Nothing to pause" ;;
  esac
}

skip() {
  case $(state) in
    down) down ;;
    idle) echo "Nothing to skip" ;;
    waiting) echo "Break's over · start focus" ;;
    *-paused)
      # tomat keeps the paused elapsed time across a skip (jolars/tomat#118); reset clears it
      run reset
      run skip || fail "Couldn't skip"; echo "Skipped" ;;
    *) run skip || fail "Couldn't skip"; echo "Skipped" ;;
  esac
}

reset() {
  [ "$(state)" = down ] && down
  run stop || fail "Couldn't reset"
  rm -f "$STATE_DIR/awaiting"
  echo "Reset"
}

status_line() {
  local muted=""
  [ -e "$STATE_DIR/muted" ] && muted=" · muted"
  case $(state) in
    idle) echo "Idle$muted" ;;
    work) echo "Focusing · $(remaining) left$muted" ;;
    work-paused) echo "Focus paused · $(remaining) left$muted" ;;
    waiting) echo "Break's over · start focus$muted" ;;
    break) echo "Break · $(remaining) left$muted" ;;
    long-break) echo "Long break · $(remaining) left$muted" ;;
    break-paused|long-break-paused) echo "Break paused · $(remaining) left$muted" ;;
    *) echo "Not running" ;;
  esac
}

cmd="${1:-status}"
shift || true
mkdir -p "$STATE_DIR"
case $cmd in
  toggle)
    case $(state) in
      work|break|long-break) pause ;;
      *) start ;;
    esac ;;
  start) start "${1:-}" ;;
  pause) pause ;;
  resume) start ;;
  skip) skip ;;
  reset|stop) reset ;;
  status) status_line ;;
  state) state ;;
  mute) touch "$STATE_DIR/muted"; echo "Muted" ;;
  unmute) rm -f "$STATE_DIR/muted"; echo "Sounds on" ;;
  toggle-mute) if [ -e "$STATE_DIR/muted" ]; then rm -f "$STATE_DIR/muted"; echo "Sounds on"; else touch "$STATE_DIR/muted"; echo "Muted"; fi ;;
  log) tail -n "${1:-20}" "$LOG" 2>/dev/null || echo "No sessions yet" ;;
  watch) exec tomat watch -o waybar -f '{time}' -i 1 ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
