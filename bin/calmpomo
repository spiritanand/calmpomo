#!/usr/bin/env bash
set -uo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:${PATH:-}"
CONF_DIR="${CALMPOMO_CONFIG_DIR:-$HOME/.config/calmpomo}"
STATE_DIR="${CALMPOMO_STATE_DIR:-$HOME/Library/Application Support/calmpomo}"
export TOMAT_CONFIG="${CALMPOMO_CONFIG_FILE:-$CONF_DIR/tomat.toml}"
export TOMAT_RUNTIME_DIR="$STATE_DIR/run"
LOG="$STATE_DIR/sessions.log"

usage() {
  cat <<'EOF'
calmpomo: calm pomodoro on top of tomat

  calmpomo toggle         start, pause or resume (one key for everything)
  calmpomo start [MIN]    start focus, or begin the next focus after a break;
                          MIN sets the focus length until the next reset
  calmpomo pause          pause
  calmpomo skip           jump to the next phase
  calmpomo reset          stop and go back to idle
  calmpomo status         one-line status
  calmpomo mute|unmute    silence or restore sounds
  calmpomo log [N]        last N session log lines (default 20)
  calmpomo check          check the config file for mistakes
  calmpomo watch          JSON stream for the menu bar plugin
EOF
}

ST=down TIME=""
query() {
  local s re='"text":"([^"]*)".*"class":"([a-z-]+)"'
  ST=down TIME=""
  s=$(tomat status -o waybar -f '{time}' 2>/dev/null) && [[ $s =~ $re ]] || return 0
  TIME=${BASH_REMATCH[1]//[!0-9:]/} ST=${BASH_REMATCH[2]}
  case $ST in
    disconnected) ST=down ;;
    work-paused) [ -e "$STATE_DIR/awaiting" ] && ST=waiting ;;
  esac
  return 0
}
state() { query; echo "$ST"; }

fail() { echo "$1"; exit 1; }
down() { fail "calmpomo isn't running · run install.sh"; }
RUN_ERR=""
run() {
  local out
  out=$(tomat "$@" 2>&1) && return
  out=${out##*$'\n'}
  out=${out#Error: }
  RUN_ERR=${out//\"/}
  return 1
}
why() { fail "$1${RUN_ERR:+ · $RUN_ERR}"; }

minutes() {
  local m=${1// /}
  m=${m%m}
  m=${m/,/.}
  [[ $m == .* ]] && m=0$m
  [[ $m =~ ^(0|[1-9][0-9]*)([.][0-9]+)?$ ]] && [[ ! $m =~ ^0+([.]0*)?$ ]] || fail "Minutes must be a number like 25 or 0.5"
  awk -v m="$m" 'BEGIN { exit !(m >= 0.02 && m <= 600) }' || fail "Minutes must be between 0.02 and 600"
  echo "$m"
}

start() {
  local st m=""
  st=$(state)
  [ "$st" = down ] && down
  if [ -n "${1:-}" ]; then
    m=$(minutes "$1") || fail "$m"
    # a fresh start resets tomat's long-break counter, so only do it when asked
    # tomat's start keeps paused time and a held work_start hook from the old session
    [ "$st" = idle ] || run stop || why "Couldn't start focus"
    run start --work "$m" || why "Couldn't start focus"
    rm -f "$STATE_DIR/awaiting"
    echo "Focus started · ${m} min"
    return
  fi
  case $st in
    idle) run start || why "Couldn't start focus"; echo "Focus started" ;;
    waiting) run resume || why "Couldn't start focus"; rm -f "$STATE_DIR/awaiting"; echo "Focus started" ;;
    work-paused|break-paused|long-break-paused) run resume || why "Couldn't resume"; echo "Resumed" ;;
    *) echo "Already running" ;;
  esac
}

pause() {
  case $(state) in
    work|break|long-break) run pause || why "Couldn't pause"; echo "Paused" ;;
    down) down ;;
    *) echo "Nothing to pause" ;;
  esac
}

skip() {
  case $(state) in
    down) down ;;
    idle) echo "Nothing to skip" ;;
    waiting) echo "Break's over · start focus" ;;
    *-paused)
      # tomat keeps the paused elapsed time across a skip (jolars/tomat#118); reset clears it
      run reset
      run skip || why "Couldn't skip"; echo "Skipped" ;;
    *) run skip || why "Couldn't skip"; echo "Skipped" ;;
  esac
}

reset() {
  case $(state) in
    down) down ;;
    idle) rm -f "$STATE_DIR/awaiting"; echo "Reset"; return ;;
  esac
  run stop || why "Couldn't reset"
  rm -f "$STATE_DIR/awaiting"
  echo "Reset"
}

status_line() {
  local muted=""
  [ -e "$STATE_DIR/muted" ] && muted=" · muted"
  query
  case $ST in
    idle) echo "Idle$muted" ;;
    work) echo "Focusing · $TIME left$muted" ;;
    work-paused) echo "Focus paused · $TIME left$muted" ;;
    waiting) echo "Break's over · start focus$muted" ;;
    break) echo "Break · $TIME left$muted" ;;
    long-break) echo "Long break · $TIME left$muted" ;;
    break-paused|long-break-paused) echo "Break paused · $TIME left$muted" ;;
    *) down ;;
  esac
}

check() {
  local rt p out err settings
  rt=$(mktemp -d /tmp/calmpomo-check.XXXXXX) || fail "Couldn't check the config"
  # a throwaway daemon is the only parser that knows tomat's rules; it falls back to defaults silently
  TOMAT_RUNTIME_DIR=$rt tomat daemon run >"$rt/out" 2>"$rt/err" &
  p=$!
  for _ in $(seq 30); do { [ -S "$rt/tomat.sock" ] || [ -s "$rt/err" ]; } && break; sleep 0.1; done
  kill "$p" 2>/dev/null
  wait "$p" 2>/dev/null
  out=$(cat "$rt/out") err=$(cat "$rt/err")
  rm -f "$rt"/*
  rmdir "$rt"
  [ -f "$TOMAT_CONFIG" ] || fail "No config at $TOMAT_CONFIG · run install.sh"
  if [[ $err == *"Failed to parse"* ]]; then
    printf '%s\n' "$err" | sed '/^Using default configuration/d'
    fail "Config has a mistake, so tomat would ignore all of it"
  fi
  if [[ $err == *"Failed to read"* || $err == *"Using default configuration"* || -z $out ]]; then
    printf '%s\n' "$err" | sed '/^Using default configuration/d'
    fail "tomat couldn't load $TOMAT_CONFIG, so it would use its defaults"
  fi
  LC_ALL=C awk '
    { sub(/#.*/, ""); gsub(/[ \t\r]/, "") }
    /^\[/ {
      sec = $0; gsub(/[][]/, "", sec)
      if (sec !~ /^(timer|sound|notification|display|hooks\.on_(work|break|long_break)_(start|end)|hooks\.on_(pause|resume|skip|stop))$/) print "Unknown section [" sec "], tomat ignores it"
      next
    }
    sec == "timer" && /=/ {
      k = $0; sub(/=.*/, "", k)
      if (k == "auto_advance") aa = $0
      else if (k !~ /^(work|break|long_break|sessions)$/) print "Unknown [timer] key " k ", tomat ignores it"
    }
    END { if (aa != "auto_advance=\"to-break\"") print "[timer] needs auto_advance = \"to-break\", or breaks won'"'"'t start by themselves" }
  ' "$TOMAT_CONFIG" | grep . && fail "Config has settings tomat would ignore"
  settings=$(printf '%s\n' "$out" | sed -n 's/^ *Timer settings: //p' | head -n 1)
  [ -n "$settings" ] || { echo "Config loads · couldn't range-check it with tomat $(tomat --version | awk '{print $2}')"; return 0; }
  LC_ALL=C awk -v s="$settings" 'BEGIN {
    n = split(s, kv, ", ")
    for (i = 1; i <= n; i++) {
      split(kv[i], p, "="); v = p[2] + 0
      if (p[1] == "sessions" && (v < 1 || v > 100)) { print "sessions must be 1 to 100"; bad = 1 }
      if (p[1] != "sessions" && (v <= 0 || v > 600)) { print p[1] " must be more than 0 and at most 600 minutes"; bad = 1 }
    }
    exit bad
  }' || fail "Config has a value tomat won't accept"
  echo "Config OK · $settings"
}

cmd="${1:-status}"
mkdir -p "$STATE_DIR"
case $cmd in
  toggle|start|pause|resume|skip|reset|stop)
    # a held-down hotkey can run two commands at once and both would act on the same state
    if [ -z "${CALMPOMO_LOCKED:-}" ]; then
      CALMPOMO_LOCKED=1 exec lockf -k -t 3 "$STATE_DIR/cli.lock" "$0" "$@"
    fi ;;
esac
shift || true
case $cmd in
  toggle)
    case $(state) in
      work|break|long-break) pause ;;
      *) start ;;
    esac ;;
  start) start "${1:-}" ;;
  pause) pause ;;
  resume) start ;;
  skip) skip ;;
  reset|stop) reset ;;
  status) status_line ;;
  state) state ;;
  mute) touch "$STATE_DIR/muted"; echo "Muted" ;;
  unmute) rm -f "$STATE_DIR/muted"; echo "Sounds on" ;;
  toggle-mute) if [ -e "$STATE_DIR/muted" ]; then rm -f "$STATE_DIR/muted"; echo "Sounds on"; else touch "$STATE_DIR/muted"; echo "Muted"; fi ;;
  log)
    n=${1:-20}
    [[ $n =~ ^[0-9]+$ ]] || fail "N must be a whole number"
    if [ -s "$LOG" ]; then tail -n "$n" "$LOG"; else echo "No sessions yet"; fi ;;
  check) check ;;
  watch) exec tomat watch -o waybar -f '{time}' -i 1 ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
